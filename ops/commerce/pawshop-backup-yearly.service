[Unit]
Description=PawShop yearly encrypted backup archive
After=pawshop-backup.service pawshop-backup-monthly.service
Requires=pawshop-backup-monthly.service

[Service]
Type=oneshot
User=pawshop-backup
Group=pawshop-backup
WorkingDirectory=/srv/pawshop-commerce/current/_commerce
EnvironmentFile=/etc/pawshop-backup/backup.env
EnvironmentFile=/etc/pawshop-backup/backup-offsite.env
Environment=PAWSHOP_BACKUP_ARCHIVE_TIER=yearly
LoadCredential=backup-s3-access-key:/etc/pawshop-backup/backup-s3-access-key
LoadCredential=backup-s3-secret-key:/etc/pawshop-backup/backup-s3-secret-key
ExecStart=/usr/bin/node scripts/archive-production-backup.mjs
TimeoutStartSec=30min
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
ProtectClock=true
RestrictSUIDSGID=true
LockPersonality=true
CapabilityBoundingSet=
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
ReadWritePaths=/var/backups/pawshop
