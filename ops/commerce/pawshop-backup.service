[Unit]
Description=PawShop encrypted PostgreSQL backup
# postgresql.service is a stub (ExecStart=/bin/true, no cluster management), so
# depending on it would order the backup against nothing and let a backup run
# while the cluster is down. Depend on the real cluster instance instead.
After=postgresql@17-main.service
Requires=postgresql@17-main.service

[Service]
Type=oneshot
User=pawshop-backup
Group=pawshop-backup
WorkingDirectory=/srv/pawshop-commerce/current/_commerce
EnvironmentFile=/etc/pawshop-backup/backup.env
EnvironmentFile=/etc/pawshop-backup/backup-offsite.env
LoadCredential=backup-s3-access-key:/etc/pawshop-backup/backup-s3-access-key
LoadCredential=backup-s3-secret-key:/etc/pawshop-backup/backup-s3-secret-key
ExecStart=/usr/bin/node scripts/backup-production.mjs
ExecStartPost=/usr/bin/node scripts/sync-production-backups.mjs
TimeoutStartSec=30min
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
ProtectClock=true
RestrictSUIDSGID=true
LockPersonality=true
CapabilityBoundingSet=
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
ReadWritePaths=/var/backups/pawshop
