[Unit]
Description=PawShop encrypted PostgreSQL backup
# postgresql.service is a stub (ExecStart=/bin/true, no cluster management), so
# depending on it would order the backup against nothing and let a backup run
# while the cluster is down. Depend on the real cluster instance instead.
After=postgresql@17-main.service
Requires=postgresql@17-main.service

[Service]
Type=oneshot
User=pawshop-backup
Group=pawshop-backup
WorkingDirectory=/srv/pawshop-commerce/current/_commerce
EnvironmentFile=/etc/pawshop-backup/backup.env
EnvironmentFile=/etc/pawshop-backup/backup-offsite.env
LoadCredential=backup-s3-access-key:/etc/pawshop-backup/backup-s3-access-key
LoadCredential=backup-s3-secret-key:/etc/pawshop-backup/backup-s3-secret-key
ExecStart=/usr/bin/node scripts/run-scheduled-backup.mjs
TimeoutStartSec=30min
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
ProtectClock=true
RestrictSUIDSGID=true
LockPersonality=true
CapabilityBoundingSet=
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
# ProtectSystem=strict makes /var read-only, so the timestamp that outlives a
# reboot needs an explicit writable location. StateDirectory is that location and
# it also owns the directory: systemd creates /var/lib/pawshop-backup as
# pawshop-backup and leaves it world-traversable, which is what lets the monitor
# account read the recorded instant.
StateDirectory=pawshop-backup
ReadWritePaths=/var/backups/pawshop
