# PawShop monitor configuration. Non-secret settings only.
# Install as /etc/pawshop-monitor/monitoring.env, owner root, group pawshop, mode 0640.
# The alert webhook path may contain a channel identifier, so this file stays 0640
# and must never be committed with a real value.

# Required. The real public storefront origin (https, no path).
PAWSHOP_MONITOR_STOREFRONT_ORIGIN=https://pawlivora.com

# Required. The loopback-only commerce admin runtime.
PAWSHOP_MONITOR_COMMERCE_ORIGIN=http://127.0.0.1:9000

# Bounded deadlines and thresholds.
PAWSHOP_MONITOR_TIMEOUT_MS=10000
PAWSHOP_MONITOR_LATENCY_BUDGET_MS=3000
PAWSHOP_MONITOR_MIN_TLS_DAYS=14
PAWSHOP_MONITOR_MIN_DISK_FREE_PERCENT=10
PAWSHOP_MONITOR_MAX_BACKUP_AGE_HOURS=36
PAWSHOP_MONITOR_ALERT_SUPPRESSION_MINUTES=30

# Phase control. Before the first commerce release is activated nothing listens
# on the commerce origin, so probing it would report a permanent outage. Set to 1
# to record the three commerce checks as explicitly skipped instead. Every run
# still logs a WARN and every check detail says "skipped by explicit
# configuration", so a skipped invariant is never mistaken for a verified one.
# Remove this line as soon as a commerce release is active, or a real commerce
# outage will be hidden.
# PAWSHOP_MONITOR_SKIP_COMMERCE_CHECKS=1

# Local alert state (rate limiting between repeated alerts).
PAWSHOP_MONITOR_STATE_FILE=/var/lib/pawshop-monitor/alert-state.json

# Optional. Leave unset for log-only monitoring.
# PAWSHOP_MONITOR_ALERT_CHANNELS lists every channel an alert is posted to, comma
# separated, each written as provider:https://host/path. Alerting is the one
# subsystem whose failure is silent, so a second channel is cheap insurance: a
# revoked webhook, a deleted group or a vendor outage then costs one channel
# instead of the alarm. One acknowledgement is enough to count the alert as
# delivered; channels that stay quiet are named in the journal every time.
# Each chat platform accepts only its own message schema, and the provider in the
# entry decides which one is sent, so a mismatch is impossible by construction.
#   generic  - raw pawshop-monitor-alert-v1 JSON, for an internal endpoint
#   slack    - https://hooks.slack.com/services/T000/B000/XXXX
#   feishu   - https://open.feishu.cn/open-apis/bot/v2/hook/XXXX (or open.larksuite.com)
#   telegram - https://api.telegram.org/bot<id>:<secret>/sendMessage, plus the chat id
# The monitor refuses a webhook whose host does not belong to its provider, and
# refuses to start if both this and PAWSHOP_MONITOR_ALERT_WEBHOOK are set.
# PAWSHOP_MONITOR_ALERT_CHANNELS=feishu:https://open.feishu.cn/open-apis/bot/v2/hook/CHANNEL-ID,slack:https://hooks.slack.com/services/T000/B000/XXXX
# PAWSHOP_MONITOR_TELEGRAM_CHAT_ID=-1001234567890
#
# The single-channel form is still accepted when exactly one channel exists:
# PAWSHOP_MONITOR_ALERT_PROVIDER=feishu
# PAWSHOP_MONITOR_ALERT_WEBHOOK=https://open.feishu.cn/open-apis/bot/v2/hook/CHANNEL-ID

# The last successful backup time, as recorded by the backup service itself.
# Set this: the monitor reads both this file and the unit state, and the two
# answer different questions. The unit says whether the most recent attempt
# failed (the only signal that arrives within minutes); the file says when the
# last success happened (the only signal that survives a reboot - systemd keeps
# no completion timestamp for a unit that has not run since the host booted, so
# depending on the unit alone reported a false failure after every reboot until
# the next scheduled run). Both must pass. Leave it unset only on a host whose
# backup service does not write it yet; the check then falls back to unit state.
PAWSHOP_MONITOR_BACKUP_TIMESTAMP_FILE=/var/lib/pawshop-backup/last-success.txt
