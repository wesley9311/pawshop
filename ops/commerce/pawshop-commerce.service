[Unit]
Description=PawShop private Medusa commerce admin
# postgresql.service is a stub (ExecStart=/bin/true): ordering against it proved
# nothing and would let the app start with the cluster down. Use the real instance.
After=network-online.target postgresql@17-main.service redis-server.service
Wants=network-online.target
Requires=postgresql@17-main.service redis-server.service

[Service]
Type=simple
User=pawshop
Group=pawshop
WorkingDirectory=/srv/pawshop-commerce/current/_commerce
EnvironmentFile=/etc/pawshop/commerce.env
# Google OAuth credentials live in a separate file (0600 root:root), outside the
# closed 20-key contract enforced on commerce.env. systemd (root) reads it at
# exec time and injects GOOGLE_* into the process environment; the pawshop user
# never reads this file directly. Absent values degrade to emailpass-only.
EnvironmentFile=/etc/pawshop/google-oauth.env
# CloudGull Connector credentials (V1.1) also live in their own file, for the same
# reason: commerce.env is a closed 20-key contract. The leading `-` makes this
# file OPTIONAL — a missing non-optional EnvironmentFile makes systemd refuse to
# start the unit, and the connector must be unable to take the shop down. With no
# file present the connector simply answers CONNECTOR_NOT_CONFIGURED.
EnvironmentFile=-/etc/pawshop/connector.env
Environment=NODE_OPTIONS=--max-old-space-size=768
ExecStartPre=/usr/bin/node scripts/preflight-production-host.mjs
ExecStart=/usr/bin/node scripts/run-production.mjs start
ExecStartPost=/usr/bin/node scripts/wait-production-admin.mjs
Restart=on-failure
RestartSec=5s
MemoryHigh=1G
MemoryMax=1200M
TimeoutStartSec=180s
TimeoutStopSec=30s
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
ProtectClock=true
RestrictSUIDSGID=true
LockPersonality=true
CapabilityBoundingSet=
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
ReadWritePaths=/var/lib/pawshop
InaccessiblePaths=-/var/backups/pawshop -/etc/pawshop-backup

[Install]
WantedBy=multi-user.target
