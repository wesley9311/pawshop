# PawShop Connector credentials for the CloudGull Connector API V1.1.
#
# THIS FILE IS A TEMPLATE. It contains no secret, and it must never contain one:
# real values are injected by the deployment's secret manager and live only in
# /etc/pawshop/connector.env (0600 root:root) on the host.
#
# WHY A SEPARATE FILE
# commerce.env is a closed 20-key contract that the deployment validates, and
# google-oauth.env set the precedent for keeping unrelated secrets out of it.
# systemd reads this file as a second, OPTIONAL EnvironmentFile
# (`EnvironmentFile=-/etc/pawshop/connector.env`): the leading `-` matters,
# because a missing non-optional EnvironmentFile makes systemd refuse to start
# the commerce unit outright.
#
# The variable names mirror CloudGull's client-side contract exactly. PawShop
# holds the same key id / token / signing secret for VERIFICATION that CloudGull
# holds for SIGNING — they are two copies of one credential, and they must match
# byte for byte or every request will be refused with
# INVALID_SERVICE_CREDENTIAL / INVALID_REQUEST_SIGNATURE.
#
# Allowed scopes are exactly:
#   connector:health:read     read GET /api/connector/v1/health
#   connector:products:write  create or update a product

# --- current slot -----------------------------------------------------------
# PAWSHOP_CONNECTOR_KEY_ID=
# PAWSHOP_CONNECTOR_SERVICE_TOKEN=
# PAWSHOP_CONNECTOR_SIGNING_SECRET=
# PAWSHOP_CONNECTOR_SCOPES=connector:health:read connector:products:write
# PAWSHOP_CONNECTOR_KEY_VERSION=1
# Optional validity window (ISO 8601). Outside it the credential is refused.
# PAWSHOP_CONNECTOR_NOT_BEFORE=
# PAWSHOP_CONNECTOR_EXPIRES_AT=

# --- next slot (rotation overlap) -------------------------------------------
# PawShop accepts current AND next at the same time; CloudGull signs with the
# last credential that is active, which is the one with the higher version.
# PAWSHOP_CONNECTOR_KEY_ID_NEXT=
# PAWSHOP_CONNECTOR_SERVICE_TOKEN_NEXT=
# PAWSHOP_CONNECTOR_SIGNING_SECRET_NEXT=
# PAWSHOP_CONNECTOR_SCOPES_NEXT=connector:health:read connector:products:write
# PAWSHOP_CONNECTOR_KEY_VERSION_NEXT=2
# PAWSHOP_CONNECTOR_NOT_BEFORE_NEXT=
# PAWSHOP_CONNECTOR_EXPIRES_AT_NEXT=

# --- media host policy (optional) -------------------------------------------
# Comma-separated allowlist for `product.media[].url`. When unset the connector
# falls back to the storefront's own image hosts, which means a CloudGull-hosted
# image URL is refused with 422 until the host policy is stated here explicitly.
# PAWSHOP_CONNECTOR_MEDIA_HOSTS=media.pawlivora.com
