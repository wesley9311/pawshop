# Documentation only. Install privately as /etc/pawshop-backup/backup.env mode 0640.
NODE_ENV=production
PAWSHOP_MODE=production-admin-only
PAWSHOP_INFRA_TOPOLOGY=single-host-private
DATABASE_URL=postgresql://pawshop_backup:replace-me@127.0.0.1:5432/pawshop?sslmode=disable
PAWSHOP_BACKUP_DIR=/var/backups/pawshop
PAWSHOP_BACKUP_KEY_FILE=/etc/pawshop-backup/backup.key
