server {
  server_name pawlivora.com www.pawlivora.com _;
  root /srv/pawshop/current;
  index index.html;
  charset utf-8;
  add_header X-Content-Type-Options "nosniff" always;
  add_header X-Frame-Options "DENY" always;
  add_header Strict-Transport-Security "max-age=15552000" always;
  if ($host = www.pawlivora.com) {
    return 301 https://pawlivora.com$request_uri;
  }
  location = /admin.html { return 404; }
  location = /dashboard.html { return 404; }
  location = /account.html { return 404; }
  # Commerce admin API reverse proxy (Task B, 2026-09-19).
  # Legacy Basic Auth removed (2026-09-22): the admin UI calls /admin/* after
  # the user is authenticated, and that leftover nginx gate was re-prompting
  # owner/password mid-session. Authorization now lives entirely in Medusa
  # (JWT + session + actor checks); /admin/users/me and friends return 401
  # from Medusa for anonymous callers, and feature-flags is public by design.
  location /admin/ {
    limit_req zone=pawshop_admin_api burst=40 nodelay;
    limit_req_status 429;
    client_max_body_size 20m;
    proxy_pass http://127.0.0.1:9000;
    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto https;
    proxy_read_timeout 120s;
  }
  location = /auth/session {
    # no Basic here on purpose: Medusa validates the Bearer JWT itself,
    # and that token is only obtainable through the provider login flow.
    limit_req zone=pawshop_admin_login burst=5 nodelay;
    limit_req_status 429;
    proxy_pass http://127.0.0.1:9000;
    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto https;
  }
  location /auth/user/ {
    # Legacy Basic Auth removed (2026-09-22). The login flow (provider list,
    # emailpass, google, google/callback) must be reachable without the old
    # owner/password gate so "Continue with Google" leads straight into the
    # admin. Medusa's own JWT + session + actor permission checks protect the
    # admin API; the login endpoints are further bounded by pawshop_admin_login.
    limit_req zone=pawshop_admin_login burst=5 nodelay;
    limit_req_status 429;
    proxy_pass http://127.0.0.1:9000;
    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto https;
  }

  # Public Store API reverse proxy (P0-4, 2026-09-19). no Basic Auth on purpose:
  # this is the namespace a shopper's own browser calls, and its only credential
  # is the store's publishable key, which is public by design.
  location /store/ {
    limit_req zone=pawshop_store_api burst=60 nodelay;
    limit_req_status 429;
    proxy_pass http://127.0.0.1:9000;
    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto https;
    proxy_read_timeout 60s;
  }
  # PayPal webhook ingress (2026-09-27). PayPal POSTs payment events here after
  # the buyer approves/captures/refunds. No Basic Auth on purpose: PayPal's
  # server-to-server callback has no user and cannot supply credentials. The real
  # access control is the provider's webhook signature verification — Medusa's
  # /hooks/payment/:provider route forwards the raw body + headers without
  # verifying, so the PayPal provider asks PayPal to verify the transmission
  # before acting on any event. This is the ONLY additional route: nothing else
  # (Media/Auth/CDN/CloudGull) is touched.
  #
  # The URL segment is NOT free-form. Medusa resolves the provider from the last
  # path segment by building `pp_${segment}`
  # (@medusajs/medusa .../payment/[provider]/route.js -> payment module
  # `providerId = pp_<segment>`), and the payment module registers each provider
  # under `pp_<identifier>_<id>`
  # (@medusajs/payment .../loaders/providers.js). With identifier `paypal` and
  # id `paypal` the only working segment is `paypal_paypal`. Posting to
  # /hooks/payment/paypal fails inside Medusa with
  # `Could not resolve 'pp_paypal'` and the event is dropped.
  location /hooks/payment/ {
    limit_req zone=pawshop_webhook burst=30 nodelay;
    limit_req_status 429;
    proxy_pass http://127.0.0.1:9000;
    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto https;
    proxy_read_timeout 60s;
  }
  # Short-path alias for the PayPal webhook. The PayPal developer dashboard's
  # webhook editor accepts this URL and we registered it as
  # https://pawlivora.com/hooks/payment/paypal, so the alias keeps the dashboard
  # configuration working as-is while Medusa receives the provider key it needs.
  # Exact match (`=`) on purpose: it must not shadow the prefix location above,
  # which still serves the canonical /hooks/payment/paypal_paypal path unchanged.
  location = /hooks/payment/paypal {
    limit_req zone=pawshop_webhook burst=30 nodelay;
    limit_req_status 429;
    proxy_pass http://127.0.0.1:9000/hooks/payment/paypal_paypal;
    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto https;
    proxy_read_timeout 60s;
  }
  # CloudGull Connector API V1.1 (2026-09-27). Server-to-server, so there is no
  # Basic Auth gate and none is wanted: every request is authenticated by an HMAC
  # request signature over the raw body, a service token, a scope check and a
  # replay guard, all enforced inside the connector.
  #
  # The trailing slash on proxy_pass is load-bearing. The signature covers the
  # PUBLIC path (/api/connector/v1/...), and the connector rebuilds that string
  # from its own mounted path (/connector/v1/...). This rewrite is what ties the
  # two together; forwarding the public path unchanged would make the canonical
  # string depend on the internal route layout instead.
  location /api/connector/v1/ {
    limit_req zone=pawshop_connector burst=30 nodelay;
    limit_req_status 429;
    client_max_body_size 2m;
    proxy_pass http://127.0.0.1:9000/connector/v1/;
    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto https;
    proxy_read_timeout 60s;
  }

  # Owner-facing admin console (2026-09-19). The UI is the stock Medusa admin
  # build served at /app; its router basename and its asset URLs are compiled in
  # as /app (basename:"/app", and the chunk loader builds "/app/"+name), so the
  # browser address has to live under /app for client-side routing to work.
  # /console/ is the stable entry the owner bookmarks; it hands over with a
  # redirect instead of pretending the same bundle can serve a second prefix.
  location = /console { return 302 /app/$is_args$args; }
  location ^~ /console/ {
    rewrite ^/console/(.*)$ /app/$1 redirect;
  }
  location = /app { return 302 /app/$is_args$args; }
  location ^~ /app/ {
    # Legacy Basic Auth removed (2026-09-22): the admin shell and its assets must
    # load without the old owner/password gate. Authentication now happens inside
    # the Medusa admin login (Google OAuth, emailpass fallback), not at nginx.
    limit_req zone=pawshop_console_ui burst=120 nodelay;
    limit_req_status 429;
    proxy_pass http://127.0.0.1:9000;
    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto https;
    proxy_read_timeout 120s;
  }

  location / { try_files $uri $uri/ =404; }

    listen [::]:443 ssl ipv6only=on; # managed by Certbot
    listen 443 ssl; # managed by Certbot
    ssl_certificate /etc/letsencrypt/live/pawlivora.com/fullchain.pem; # managed by Certbot
    ssl_certificate_key /etc/letsencrypt/live/pawlivora.com/privkey.pem; # managed by Certbot
    include /etc/letsencrypt/options-ssl-nginx.conf; # managed by Certbot
    ssl_dhparam /etc/letsencrypt/ssl-dhparams.pem; # managed by Certbot


}
server {
    if ($host = www.pawlivora.com) {
        return 301 https://$host$request_uri;
    } # managed by Certbot


    if ($host = pawlivora.com) {
        return 301 https://$host$request_uri;
    } # managed by Certbot


  listen 80 default_server;
  listen [::]:80 default_server;
  server_name pawlivora.com www.pawlivora.com _;
    return 404; # managed by Certbot




}
