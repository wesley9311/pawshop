{
  "name": "pawshop-commerce",
  "version": "0.1.0",
  "private": true,
  "description": "Local-only self-hosted PawShop commerce foundation",
  "engines": { "node": "^22.12.0 || ^24.0.0" },
  "scripts": {
    "setup:local": "node scripts/setup-local.mjs",
    "build": "node scripts/run-local.mjs build",
    "build:ci": "medusa build",
    "dev": "node scripts/run-local.mjs develop",
    "db:migrate": "node scripts/run-local.mjs db:migrate",
    "admin:create": "node scripts/create-local-admin.mjs",
    "catalog:import": "node scripts/run-local.mjs exec ./src/scripts/import-catalog.ts",
    "catalog:verify": "node scripts/run-local.mjs exec ./src/scripts/verify-catalog.ts",
    "foundation:verify": "node scripts/verify-foundation.mjs",
    "check:types": "tsc --noEmit",
    "test": "node --test tests/*.test.cjs"
  },
  "dependencies": {
    "@medusajs/admin-sdk": "2.19.0",
    "@medusajs/cli": "2.19.0",
    "@medusajs/framework": "2.19.0",
    "@medusajs/medusa": "2.19.0"
  },
  "devDependencies": {
    "@swc/core": "^1.7.28",
    "@types/node": "^22.0.0",
    "@types/react": "^18.3.2",
    "@types/react-dom": "^18.2.25",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "ts-node": "10.9.2",
    "typescript": "^5.6.2",
    "vite": "^6.0.0"
  }
}
