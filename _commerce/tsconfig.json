{
  "compilerOptions": {
    "target": "ES2021",
    "module": "Node16",
    "moduleResolution": "Node16",
    "esModuleInterop": true,
    "emitDecoratorMetadata": true,
    "experimentalDecorators": true,
    "skipLibCheck": true,
    "strictNullChecks": true,
    "allowJs": true,
    "checkJs": false,
    "outDir": "./.medusa/server",
    "rootDir": ".",
    "jsx": "react-jsx",
    "resolveJsonModule": true
  },
  "ts-node": { "swc": true },
  "include": ["medusa-config.ts", "src/**/*", ".medusa/types/*"],
  "exclude": ["node_modules", ".medusa/server", ".medusa/admin"]
}
