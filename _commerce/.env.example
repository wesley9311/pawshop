# Documentation only. Never put real credentials in this file or Git.
NODE_ENV=production
PAWSHOP_MODE=production-admin-only
PAWSHOP_INFRA_TOPOLOGY=single-host-private
DATABASE_URL=postgresql://pawshop:replace-me@127.0.0.1:5432/pawshop?sslmode=disable
REDIS_URL=redis://pawshop:replace-me@127.0.0.1:6379/0
JWT_SECRET=replace-with-32-random-bytes-as-hex
COOKIE_SECRET=replace-with-a-different-32-random-bytes-as-hex
STOREFRONT_ORIGIN=https://pawlivora.com
ADMIN_ORIGIN=http://127.0.0.1:9000
MEDUSA_WORKER_MODE=shared
PORT=9000
S3_FILE_URL=https://media.example.invalid/pawshop
S3_ACCESS_KEY_ID=replace-me
S3_SECRET_ACCESS_KEY=replace-me
S3_REGION=replace-me
S3_BUCKET=replace-me
S3_ENDPOINT=https://s3.example.invalid
S3_FORCE_PATH_STYLE=0
S3_DISABLE_ACL=1

# Set only after a verified backup and an explicit successful migration.
PAWSHOP_MIGRATIONS_CONFIRMED=0
